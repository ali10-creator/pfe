  <origin xyz="0.1 -0.02 0.09" rpy="0 0 0"/>
  <axis
      xyz="1 0 0" />
</joint>

<link name="imu_link">
  <visual>
    <geometry>
      <box size="0.05 0.05 0.05"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.05 0.05 0.05"/>
