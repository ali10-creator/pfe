<?xml version="1.0" encoding="utf-8"?>
<robot name="lyes">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0.6 0.35 1.005" rpy="-0.118 -0.15 -1.85" />
      <geometry>
        <mesh filename="file:///home/ali/pfe/src/robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.990196109 1 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.28 0.22" />
      </geometry>
      <origin xyz="0 0 0.17" rpy="0 0 0" />
    </collision>
    <inertial>
      <mass value="1.3" />
      <origin xyz="0 -0.01 0.17" rpy="0 0 0" />
      <inertia ixx="0.01374" ixy="0.0" ixz="0.0"
           iyy="0.02257" iyz="0.0"
           izz="0.02583" />
    </inertial>
  </link>

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Castor Link -->
  <link name="castor_link">
    <inertial>
      <origin xyz="0.03 0 -0.03" rpy="0 0 0" />
      <mass value="0.066683900000000004"/>
      <inertia ixx="4.267e-05" ixy="0.0" ixz="0.0"
           iyy="4.267e-05" iyz="0.0"
           izz="4.267e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ali/pfe/src/robot_description/meshes/castor_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.990196109 1 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.028" />
      </geometry>
      <origin xyz="0.03 0 -0.03" rpy="0 0 0" />
    </collision>
  </link>

  <joint name="caston_joint" type="fixed">
    <origin xyz="0.12 -0.04 0.026" rpy="1.57 0 0" />
    <parent link="base_link" />
    <child link="castor_link" />
  </joint>

  <!-- IMU Link -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="4.167e-05" iyy="4.167e-05" izz="4.167e-05"
           ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.1 -0.02 0.09" rpy="0 0 0"/>
  </joint>

  <!-- Lidar Link (matches ali.sdf) -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5"
           ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.13 0 0.27" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <!-- Left Wheel -->
  <link name="wheel_left_link">
    <inertial>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <mass value="0.958007611982571" />
      <inertia ixx="0.00270268006361711" ixy="2.4073473109973E-09" ixz="-3.8235215060687E-07"
           iyy="0.00158534054425866" iyz="4.76450674947353E-10"
           izz="0.00158537407215797" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ali/pfe/src/robot_description/meshes/wheel_left_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.990196109 1 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.085" />
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
    </collision>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <origin xyz="-0.07 0.105 0.08" rpy="0 0 1.57" />
    <parent link="base_link" />
    <child link="wheel_left_link" />
    <axis xyz="1 0 0" />
  </joint>

  <!-- Right Wheel -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///home/ali/pfe/src/robot_description/meshes/wheel_right_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.990196109 1 1 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.085" />
      </geometry>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
    </collision>
    <inertial>
      <mass value="0.958007943168533" />
      <origin xyz="0.0298552074830775 8.08136260133097E-08 -7.34740256058686E-06" rpy="0 0 0" />
      <inertia ixx="0.00270267941162404" ixy="1.77502581223351E-09"  ixz="-3.85534738374735E-07"
           iyy="0.00158533885088868" iyz="-2.30500125239443E-10"
           izz="0.00158537514447048" />
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <origin xyz="-0.07 -0.12 0.082" rpy="0 0 -1.57" />
    <parent link="base_link" />
    <child link="wheel_right_link" />
    <axis xyz="-1 0 0" />
  </joint>

</robot> 